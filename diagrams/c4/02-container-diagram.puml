@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Level 2 — Container Diagram\nDelivery Orchestration Platform

Person(user, "Пользователь", "Выбирает условия доставки и получает заказ")

System_Ext(marketplace, "Marketplace / Checkout", "Оформление заказа")
System_Ext(orderService, "Order Service", "Управляет заказом")
System_Ext(paymentService, "Payment Service", "Оплата и возвраты")
System_Ext(carriers, "Carrier Systems", "Внешние службы доставки")

System_Boundary(dop, "Delivery Orchestration Platform") {

    Container(api, "Delivery API", "REST API", "Расчёт DeliveryOffer, validate, получение Delivery, отмена и возврат")

    Container(consumer, "Kafka Consumer", "Event Consumer", "Обрабатывает OrderReadyForDelivery и события согласования альтернатив")

    Container(orchestrator, "Delivery Orchestration Service", "Application / Domain Service", "Бизнес-логика Delivery, выбор Carrier, переходы состояний и обработка альтернатив")

    Container(worker, "Delivery Job Worker", "Background Worker", "Обрабатывает INITIAL и ALTERNATIVE delivery creation jobs")

    Container(reconciliation, "Reconciliation Worker", "Background Worker", "Восстанавливает состояние после timeout и неопределённых результатов Carrier")

    Container(outboxPublisher, "Outbox Publisher", "Background Worker", "Публикует доменные события из Transactional Outbox")

    ContainerDb(db, "Delivery Database", "PostgreSQL", "Shipment snapshot, DeliveryOffer, Delivery, DeliveryAttempt, processed_events, outbox, delivery_creation_jobs")

    ContainerQueue(kafka, "Kafka", "Message Broker", "Асинхронные события между DOP и Order Service")
}

Rel(user, marketplace, "Оформляет заказ")

Rel(marketplace, api, "DeliveryOffer / validate", "REST/HTTPS")
Rel(marketplace, orderService, "Создание и изменение заказа", "REST/HTTPS")

Rel(orderService, paymentService, "Оплата / возврат")

Rel(orderService, kafka, "OrderReadyForDelivery,\nDeliveryAlternativeApproved / Rejected", "Kafka")

Rel(kafka, consumer, "Доставляет события", "Kafka")

Rel(consumer, orchestrator, "Передаёт событие для обработки")
Rel(consumer, db, "processed_events,\nDelivery, Outbox, Job")

Rel(api, orchestrator, "Выполняет use cases")
Rel(api, db, "Читает / изменяет данные")

Rel(orchestrator, db, "Delivery / Offer / Attempt / Job")

Rel(worker, db, "Lease и обработка delivery_creation_jobs")
Rel(worker, orchestrator, "Запускает orchestration flow")

Rel(orchestrator, carriers, "Создание / отмена / возврат", "HTTPS")
Rel(carriers, orchestrator, "Статусы", "Webhook")

Rel(reconciliation, db, "Читает PENDING / BLOCKED операции")
Rel(reconciliation, carriers, "Проверяет фактическое состояние", "HTTPS")
Rel(reconciliation, orchestrator, "Обновляет подтверждённое состояние")

Rel(outboxPublisher, db, "Читает Outbox")
Rel(outboxPublisher, kafka, "DeliveryCreated,\nDeliveryStatusChanged,\nDeliveryAlternativeApprovalRequired", "Kafka")

Rel(kafka, orderService, "Доменные события DOP", "Kafka")

SHOW_LEGEND()

@enduml
